{
  "name": "WonderBlocks Server",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm install",
  "postStartCommand": "nohup node wonderblocks-host.js > /tmp/wonderblocks.log 2>&1 &",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "WonderBlocks",
      "onAutoForward": "notify"
    }
  }
}
